# Parsed by systemd (see sslcheck-api.service). Shell-style comments allowed.

# LISTEN — TCP address for the HTTP server (--listen).
# Default below: localhost only; put nginx/haproxy in front for TLS or public access.
# Examples: :8080 (all interfaces), 0.0.0.0:8080, [::1]:8080
LISTEN=127.0.0.1:8080
